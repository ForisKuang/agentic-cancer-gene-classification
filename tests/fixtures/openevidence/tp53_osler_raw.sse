data: {"text": "[[19]]", "reference": {"citation_key": 19, "reference_text": "Ghelli Luserna di Ror\u00e0 A, Cerchione C, Martinelli G, Simonetti G. <a target=\"_blank\" href=\"https://doi.org/10.1186/s13045-020-00959-2\">A WEE1 Family Business: Regulation of Mitosis, Cancer Progression, and Therapeutic Target</a>. Journal of Hematology & Oncology. 2020;13(1):126. doi:10.1186/s13045-020-00959-2.", "reference_detail": {"title": "A WEE1 family business: regulation of mitosis, cancer progression, and therapeutic target", "authors_string": "Ghelli Luserna di Ror\u00e0 A, Cerchione C, Martinelli G, Simonetti G.", "publication_info_string": "Journal of Hematology & Oncology. 2020;13(1):126. doi:10.1186/s13045-020-00959-2.", "journal_name": "Journal of Hematology & Oncology", "journal_short_name": "J Hematol Oncol", "publication_date": "2020-09-21", "doi": "10.1186/s13045-020-00959-2", "url": "https://doi.org/10.1186/s13045-020-00959-2"}, "source_texts": []}}

data: {"text": "\n"}

data: {"text": "3. TP53 as a biomarker in guideline-directed treatment selection"}

data: {"text": "\nThis is where NCCN and ESMO guidelines make the most concrete, actionable recommendations about TP53 \u2014 not to target it, but to avoid p"}

data: {"text": "53-dependent therapy:"}

data: {"text": "\n"}

data: {"table": {"rows": [{"Disease": "<strong>CLL/SLL</strong>", "Guideline/evidence": "NCCN Guidelines (v2.2027); ESMO; ERIC recommendations", "Role of TP53 alteration": "TP53 mutation and/or del(17p) predict resistance to chemoimmunotherapy; BTK inhibitors (preferred)"}]}}

data: {"table": {"rows": [{"Disease": "<strong>CLL/SLL</strong>", "Guideline/evidence": "NCCN Guidelines (v2.2027); ESMO; ERIC recommendations", "Role of TP53 alteration": "TP53 mutation and/or del(17p) predict resistance to chemoimmunotherapy; BTK inhibitors (preferred) or venetoclax-based regimens are used instead. TP53/del(17p) testing is mandated before each line of therapy [1-4]"}, {"Disease": "<strong>AML</strong>", "Guideline/evidence": "NCCN Guidelines (v5.2026); ELN 2022", "Role of TP53 alteration": "TP53 mutation (VAF \u226510%, mono- or biallelic) defines the adverse-"}]}}

data: {"table": {"rows": [{"Disease": "<strong>CLL/SLL</strong>", "Guideline/evidence": "NCCN Guidelines (v2.2027); ESMO; ERIC recommendations", "Role of TP53 alteration": "TP53 mutation and/or del(17p) predict resistance to chemoimmunotherapy; BTK inhibitors (preferred) or venetoclax-based regimens are used instead. TP53/del(17p) testing is mandated before each line of therapy [1-4]"}, {"Disease": "<strong>AML</strong>", "Guideline/evidence": "NCCN Guidelines (v5.2026); ELN 2022", "Role of TP53 alteration": "TP53 mutation (VAF \u226510%, mono- or biallelic) defines the adverse-risk category; associated with poor response to intensive chemo,"}]}}

data: {"table": {"rows": [{"Disease": "<strong>CLL/SLL</strong>", "Guideline/evidence": "NCCN Guidelines (v2.2027); ESMO; ERIC recommendations", "Role of TP53 alteration": "TP53 mutation and/or del(17p) predict resistance to chemoimmunotherapy; BTK inhibitors (preferred) or venetoclax-based regimens are used instead. TP53/del(17p) testing is mandated before each line of therapy [1-4]"}, {"Disease": "<strong>AML</strong>", "Guideline/evidence": "NCCN Guidelines (v5.2026); ELN 2022", "Role of TP53 alteration": "TP53 mutation (VAF \u226510%, mono- or biallelic) defines the adverse-risk category; associated with poor response to intensive chemo, HMA, and venetoclax; clinical trial enrollment is encouraged [5-6]"}, {"Disease": "<strong>MDS</strong>", "Guideline/evidence": "WHO 2022/ICC; IPSS-M", "Role of TP53 alteration": "Multi-hit/biallelic TP53 is a distinct, poor-prognosis entity; HMA \u00b1 venetoclax with consideration of allo-HCT; trial enrollment favored [7-9]"}]}}

