data: {"text": "id\": \"8fc467de-9fdd-4527-8b06-69f78000e967\", \"kind\": \"search\", \"label\": \"Searching full-text sources from NEJM, JAMA, Nature, NCCN, Cochrane, Wiley, and more\", \"id\": \"search"}

