data: {"text": "id\": \"3055bbcb-ba1d-4249-bc6e-67699a27a4fb\", \"kind\": \"search\", \"label\": \"Searching full-text sources from NEJM, JAMA, Nature, NCCN, Cochrane, Wiley, and more\", \"id\": \"search"}

