data: {"text": "\n- "}

data: {"text": "Consolidation osimertinib"}

data: {"text": " (category 1) is recommended for unresectable stage III EGFR-mutant NSCLC that has not progressed after chemoradiation, based on the "}

data: {"text": "LAURA"}

data: {"text": " trial."}

