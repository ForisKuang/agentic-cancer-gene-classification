# Which SDK path the app uses to call Claude: `anthropic` (direct API) or
# `bedrock` (AWS Bedrock). Defaults to `anthropic`. Production deploys should
# set this to `bedrock` and use the BEDROCK_* vars below instead of
# ANTHROPIC_API_KEY.
ANTHROPIC_SDK_PROVIDER=bedrock

# Required when ANTHROPIC_SDK_PROVIDER=bedrock.
BEDROCK_AWS_DEFAULT_REGION=us-east-1
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_SESSION_TOKEN=
# Preferred over static keys above: a named AWS CLI profile backed by a
# SAML-federated session (e.g. `saml2aws login --idp-account <name>`), which
# writes temporary credentials to ~/.aws/credentials under this profile name.
BEDROCK_AWS_PROFILE=490004633549-SA

# Optional: Bedrock model IDs, if different from the SYNTHESIS_MODEL /
# SYNTHESIS_FAST_MODEL / SELECTION_MODEL / RETRIEVAL_MODEL values below (which
# default to direct Anthropic model names).
BEDROCK_SYNTHESIS_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_SYNTHESIS_FAST_MODEL=
BEDROCK_SELECTION_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_RETRIEVAL_MODEL=

# Local dev only. Not needed when ANTHROPIC_SDK_PROVIDER=bedrock (the default
# for prod). Required only when ANTHROPIC_SDK_PROVIDER=anthropic, or optional
# when using --local / request.local_backend with a local agent CLI.
# Create at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: OncoKB API token for membership lookups
# Requires OncoKB account/data-access approval. Get from https://www.oncokb.org/account/settings
ONCOKB_API_TOKEN=

# Optional: NCBI API key for higher rate limits (10/sec vs 3/sec)
# Get from https://support.nlm.nih.gov/kbArticle/?pn=KA-05317
NCBI_API_KEY=

# Optional: OpenEvidence clinical-guideline / trial evidence lookup.
# Off by default (default: false). When enabled, the UI renders an
# independent, on-demand "Clinical Practice Guidelines & External Trial
# Evidence" card per gene, fetched from GET /v1/genes/{gene}/openevidence —
# never part of core gene annotation or the synthesis prompt, and its
# citations are never treated as verified PMIDs. Live (uncached) calls also
# require OPENEVIDENCE_API_KEY (org-provisioned API access via an Order Form —
# see https://github.com/oncokb/oe-api-exp); already-cached results are served
# without a key. Leave OPENEVIDENCE_ENABLED=false
# until access, pricing, rate limits, and redistribution rights are confirmed.
OPENEVIDENCE_ENABLED=false
OPENEVIDENCE_API_KEY=
OPENEVIDENCE_BASE_URL=https://api.openevidence.com
OPENEVIDENCE_MODEL=darwin
# A live-verified smoke test took ~220s without finishing a single complex
# clinical question. 60s is a more realistic floor than the old 30s default,
# but OpenEvidence may still frequently exceed even this — an accepted
# tradeoff, since this lookup is best-effort/supplementary, a timeout is not
# retried, and it never blocks or fails the core gene annotation.
OPENEVIDENCE_TIMEOUT_SECONDS=60
OPENEVIDENCE_CACHE_TTL_SECONDS=604800
# Concurrency for benchmarks/warm_openevidence_cache.py only — deliberately
# independent of ANNOTATION_GENE_CONCURRENCY, since an offline warmup pass
# can safely fan out wider than live annotation traffic.
OPENEVIDENCE_WARMUP_CONCURRENCY=5
# Max concurrent live OpenEvidence calls across all sidecar requests
# (GET /v1/genes/{gene}/openevidence), so a results page with many gene cards
# can't fan out one multi-minute vendor call per card at once.
OPENEVIDENCE_SIDECAR_CONCURRENCY=3

# Deep LLM model to use when synthesis needs escalation
SYNTHESIS_MODEL=claude-opus-4-7

# Lightweight first-pass synthesis model
SYNTHESIS_FAST_MODEL=claude-haiku-4-5-20251001

# Use lightweight synthesis first, then escalate only on weak/ambiguous outputs
SYNTHESIS_MODEL_ESCALATION=true
SYNTHESIS_ESCALATION_MIN_SUPPORT_SCORE=0.5
SYNTHESIS_ESCALATION_MIN_CITATIONS=1
SYNTHESIS_ESCALATION_TIER2=true

# Core mode keeps the first response small and latency-sensitive
CORE_SYNTHESIS_MAX_TOKENS=640
CORE_SYNTHESIS_ABSTRACT_CHARS=500
CORE_SYNTHESIS_MAX_PAPERS=6
CORE_SYNTHESIS_ESCALATION_MIN_SUPPORT_SCORE=0.0
CORE_SYNTHESIS_ESCALATION_TIER2=false

# LLM model for the citation selection pass — cheaper/faster than synthesis model
SELECTION_MODEL=claude-haiku-4-5-20251001

# Lightweight LLM model for interpreting feedback into GitHub issue drafts
FEEDBACK_MODEL=claude-haiku-4-5-20251001
# Default: true. Set false to disable public GitHub issue creation and LLM
# drafting while continuing to store feedback.
FEEDBACK_ISSUE_CREATION_ENABLED=true
# Rolling per-client-IP hourly limit, per worker; resets on process restart.
FEEDBACK_RATE_LIMIT_PER_HOUR=10
# TODO: Product decision pending on feedback authentication and CORS restrictions.
# Contact email stays internal; submissions repeating it in public content stay internal too.

# Background (never blocking) distillation of retrieved abstracts into the
# permanent MySQL pmid_evidence cache for reuse by future synthesis runs.
# Off by default (default: false).
PMID_DISTILLATION_ENABLED=false

# LLM model for Tier 2 agentic PubMed query planning — cheaper/faster than
# synthesis model; this is a query-suggestion task, not grounded synthesis
RETRIEVAL_MODEL=claude-haiku-4-5-20251001

# Fine-grained GitHub PAT scoped to Issues: write on GITHUB_REPO below, used to
# file curator feedback as a GitHub issue server-side. Curators submitting
# feedback don't need a GitHub account themselves. Create at
# https://github.com/settings/personal-access-tokens (repository access
# restricted to this repo, permission Issues: Read and write).
# When unset, feedback is still stored but the issue draft is only returned to
# the client to open manually on github.com.
ONCOKBDEV_PRIVATE_ACCESS_TOKEN=
GITHUB_REPO=oncokb/agentic-cancer-gene-classification

# Max PubMed abstracts to retrieve per gene across all Tier 1 queries (default: 50)
PUBMED_MAX_RESULTS=50

# Max PubMed abstracts to retrieve per exact fusion evidence query (default: 20)
FUSION_EVIDENCE_MAX_RESULTS=20

# Cache exact fusion/tumor PubMed evidence lookups for one week by default
FUSION_EVIDENCE_CACHE_TTL_SECONDS=604800

# Number of exact fusion evidence lookups to run concurrently per background job
FUSION_EVIDENCE_CONCURRENCY=2

# Minimum papers to declare strong cancer association before falling to Tier 2 (default: 4)
MIN_PAPERS_FOR_STRONG_ASSOCIATION=4

# Papers passed to synthesis after selection pass (default: 8)
# Increasing improves recall at the cost of larger synthesis context and higher token cost
MAX_PAPERS_FOR_SYNTHESIS=8

# Max PMIDs emitted per annotation after verification (default: 8, matching
# MAX_PAPERS_FOR_SYNTHESIS so a gene with that many strong candidates isn't
# artificially capped below what was actually retrieved and considered)
# Lower values favor citation precision; higher values may improve citation recall
MAX_CITATIONS_PER_ANNOTATION=8

# Latency optimization knobs
# Number of genes annotated concurrently at the pipeline level
ANNOTATION_GENE_CONCURRENCY=3

# Number of concurrent LLM calls across selection, synthesis, and agentic retrieval
LLM_CONCURRENCY=2

# Run Tier 1 PubMed retrieval in stages and stop after enough abstracts are found
PUBMED_STAGED_RETRIEVAL=true

# Only use the LLM selection pass for corpora up to this size.
# Larger corpora use deterministic ranked top papers to avoid an extra large LLM call.
SELECTION_LLM_THRESHOLD=24

# Redis cache for slow-changing external reference lookups (HGNC gene
# normalization, the OncoKB curated gene list, PubMed literature). Optional -
# the pipeline falls through to live calls if Redis is unreachable.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=86400

# Redis Sentinel (master/replica with automatic failover), for production
# deployments behind a Sentinel-managed Redis. When enabled, this replaces
# REDIS_URL entirely — all reads and writes go through the current master,
# discovered dynamically via Sentinel (never a fixed host:port).
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_HOSTS=sentinel-0:26379,sentinel-1:26379,sentinel-2:26379
REDIS_SENTINEL_MASTER_SET=mymaster
REDIS_SENTINEL_PASSWORD=

# Gene annotation cache policy for the MySQL-backed reusable gene_annotations table.
# Run-level results remain queryable by run_id in the runs table.
GENE_CACHE_ENABLED=true
GENE_CACHE_ONCOKB_CHECK_DAYS=90
GENE_CACHE_HIGH_SUPPORT_DAYS=60
GENE_CACHE_MEDIUM_SUPPORT_DAYS=30
GENE_CACHE_LOW_SUPPORT_DAYS=14
GENE_CACHE_FINAL_ANNOTATION_DAYS=180
GENE_CACHE_HIGH_SUPPORT_THRESHOLD=0.8
GENE_CACHE_MEDIUM_SUPPORT_THRESHOLD=0.5
GENE_CACHE_FRESHNESS_PMIDS=20

# MySQL connection for the run-result store (GET /v1/annotate/{run_id}).
# Defaults match `docker compose up mysql`.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=acgc
MYSQL_PASSWORD=acgc
MYSQL_DATABASE=acgc

# Alternative to MYSQL_HOST/MYSQL_PORT: a JDBC-style connection string, as
# used by shared-RDS secrets (e.g. "jdbc:mysql://host:3306"). When set, host
# and port are parsed from it and take precedence over MYSQL_HOST/MYSQL_PORT.
# DB_USERNAME/DB_PASSWORD similarly take precedence over MYSQL_USER/
# MYSQL_PASSWORD when set. MYSQL_DATABASE is unaffected either way — a JDBC
# URL identifies a server, not a specific database.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Public UI origin used when generating OAuth callbacks and metadata URLs.
PUBLIC_APP_BASE_URL=https://acgc.oncokb.org

# Authentication & Google Login / SSO
# Set AUTH_ENABLED=true to enforce login on protected endpoints and static UI.
AUTH_ENABLED=false
# Secret key for HMAC session signing (generate with: openssl rand -hex 32)
AUTH_SECRET_KEY=
# Cookie session duration in seconds (default: 7 days = 604800)
AUTH_SESSION_TTL_SECONDS=604800
# Comma-separated domains authorized for login (strictly enforced)
ALLOWED_EMAIL_DOMAINS=mskcc.org,openevidence.com
# Optional: Comma-separated list of individual allowed emails for fine-grained user allowlisting
ALLOWED_EMAILS=
# Google Cloud Console OAuth 2.0 Web Application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback URL (default: {PUBLIC_APP_BASE_URL}/auth/callback/google)
GOOGLE_REDIRECT_URI=
# Enable mock SSO selector in dev environments for rapid local testing without live Google credentials
DEV_LOGIN_ENABLED=false

# Enterprise SAML 2.0 & Claims Processing (e.g., Azure AD / MSK PingFederate / Okta)
SAML_ENABLED=false
# Service Provider Entity ID (defaults to {PUBLIC_APP_BASE_URL}/auth/saml/metadata)
SAML_SP_ENTITY_ID=
# IdP Single Sign-On HTTP-POST / Redirect URL
SAML_IDP_SSO_URL=
# IdP Issuer / Entity ID
SAML_IDP_ENTITY_ID=
# Optional: comma-separated list of required SAML groups/roles (e.g. MSK-OncoKB-Curators)
SAML_ALLOWED_GROUPS=
# Optional: comma-separated list of SAML groups that grant the "admin" role
SAML_ADMIN_GROUPS=

# JIT (Just-In-Time) User Provisioning
JIT_PROVISIONING_ENABLED=true
# Default role for new users: curator, annotator, viewer
JIT_DEFAULT_ROLE=curator
# If true, new JIT-provisioned users start in "pending" status until approved by an admin
JIT_REQUIRE_ADMIN_APPROVAL=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional Datadog product metrics via DogStatsD. APM tracing is already wired
# through ddtrace-run; enable this when a Datadog Agent is available.
DATADOG_METRICS_ENABLED=false
DATADOG_METRICS_NAMESPACE=acgc

# Leave DATADOG_STATSD_HOST/PORT unset in most deployments — the client then
# falls through to DogStatsd's own DD_DOGSTATSD_URL/DD_AGENT_HOST/
# DD_DOGSTATSD_PORT env var detection, which is what actually resolves to
# the Datadog Agent (e.g. a Unix domain socket injected by the cluster's
# admission controller). Only set these to pin a fixed UDP target instead.
DATADOG_STATSD_HOST=
DATADOG_STATSD_PORT=

# Header used to count active users. Do not tag Datadog metrics with raw user IDs.
# Have auth/SSO/API gateway inject this if the app does not authenticate users itself.
DATADOG_USER_ID_HEADER=x-user-id

# Docker local-agent mode:
#   docker compose --profile local up --build annotation-service-local
#
# The local profile installs Codex and Claude Code CLIs in the container and mounts:
#   ${HOME}/.codex -> /home/appuser/.codex
#   ${HOME}/.claude -> /home/appuser/.claude
#   ${HOME}/.claude.json -> /home/appuser/.claude.json
#
# API calls can then include:
#   {"fusions":["TP53::BRAF"],"local_backend":"codex"}
